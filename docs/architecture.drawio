        </mxCell>
        <mxCell id="analogy-v12" value="&lt;b&gt;🏷️ Office's own staff pass&lt;/b&gt;&lt;br&gt;= default instance identity (container)&lt;br&gt;runs the building (model, Toolbox) · opens &lt;b&gt;no&lt;/b&gt; vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="analogy-1">
