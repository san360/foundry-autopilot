        <mxCell id="lifecycle-v6" value="&lt;b&gt;Onboard&lt;/b&gt;&lt;br&gt;&lt;i&gt;Manager / access manager&lt;/i&gt;&lt;br&gt;Audience, listening &amp;amp; messaging scope, access, source of truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
