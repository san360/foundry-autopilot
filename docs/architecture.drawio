        <mxCell id="analogy-v9" value="&lt;b&gt;👤 Employee record&lt;/b&gt;&lt;br&gt;= &lt;b&gt;agent user&lt;/b&gt; publicsectorbids@…&lt;br&gt;desk · mailbox · Teams · manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="analogy-1">
