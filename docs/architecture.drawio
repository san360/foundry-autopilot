  <diagram id="hiring" name="Hiring steps &amp; permissions">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="hiring-0" />
        <mxCell id="hiring-1" parent="hiring-0" />
        <mxCell id="hiring-v1" value="From zero to a working instance – prerequisites, steps, who does what, which permission lands where" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="hiring-1">
          <mxGeometry x="40" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v2" value="&lt;b&gt;Prerequisites&lt;/b&gt;&lt;br&gt;&lt;br&gt;P1 · Frontier enrollment + free Frontier seats (1 per instance)&lt;br&gt;&lt;br&gt;P2 · Owner on the subscription / RG, &lt;b&gt;active&lt;/b&gt; (PIM-eligible in Zava → activate)&lt;br&gt;&lt;br&gt;P3 · Global or AI Administrator (approval, admin consent)&lt;br&gt;&lt;br&gt;P4 · Licensed manager in the hiring scope&lt;br&gt;&lt;br&gt;P5 · Region capacity (model, Azure AI Search)&lt;br&gt;&lt;br&gt;P6 · az, azd + Foundry extension, PowerShell 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="hiring-1">
          <mxGeometry x="40" y="80" width="240" height="370" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v3" value="&lt;b&gt;Developer / Azure admin (Owner)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=11;" vertex="1" parent="hiring-1">
          <mxGeometry x="300" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v4" value="&lt;b&gt;1 · azd provision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bicep: Foundry account + project, model, ACR, monitoring, Azure AI Search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="hiring-1">
          <mxGeometry x="300" y="130" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v5" value="&lt;b&gt;Permissions granted&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Deployer:&lt;/b&gt; Foundry User (project) · Log Analytics Reader · Search Service Contributor + Search Index Data Contributor&lt;br&gt;&lt;b&gt;Project MI:&lt;/b&gt; AcrPull · Cognitive Services User · monitoring roles" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="hiring-1">
          <mxGeometry x="300" y="280" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v6" value="&lt;b&gt;Developer / Azure admin (Owner)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=11;" vertex="1" parent="hiring-1">
          <mxGeometry x="510" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v7" value="&lt;b&gt;2 · agent version&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hook builds the image and creates the hosted agent version. Foundry creates the &lt;b&gt;blueprint&lt;/b&gt; + default instance identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="hiring-1">
          <mxGeometry x="510" y="130" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v8" value="&lt;b&gt;Permissions granted&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Default instance identity:&lt;/b&gt; Foundry User (project)&lt;br&gt;&lt;b&gt;No Search role&lt;/b&gt; (the shared container must get 403)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="hiring-1">
          <mxGeometry x="510" y="280" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hiring-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="hiring-1" source="hiring-v4" target="hiring-v7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v10" value="&lt;b&gt;Developer / Azure admin (Owner)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=11;" vertex="1" parent="hiring-1">
          <mxGeometry x="720" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v11" value="&lt;b&gt;3 · publish&lt;/b&gt;&lt;br&gt;&lt;br&gt;publishAsAutopilot with the declared scopes → request in the Microsoft 365 admin center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="hiring-1">
          <mxGeometry x="720" y="130" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v12" value="&lt;b&gt;Permissions granted&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nothing granted yet: scopes are only &lt;i&gt;declared&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="hiring-1">
          <mxGeometry x="720" y="280" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hiring-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="hiring-1" source="hiring-v7" target="hiring-v11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v14" value="&lt;b&gt;Global or AI Administrator&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=11;" vertex="1" parent="hiring-1">
          <mxGeometry x="930" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v15" value="&lt;b&gt;4 · approve + consent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Approve the request and grant admin consent (admin center, or Graph oauth2PermissionGrants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="hiring-1">
          <mxGeometry x="930" y="130" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v16" value="&lt;b&gt;Permissions granted&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Blueprint principal&lt;/b&gt; (AllPrincipals → every instance): Agent Tools McpServers.* · AgentData.ReadWrite · app role OtelWrite" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="hiring-1">
          <mxGeometry x="930" y="280" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hiring-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="hiring-1" source="hiring-v11" target="hiring-v15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v18" value="&lt;b&gt;Manager (or admin)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=11;" vertex="1" parent="hiring-1">
          <mxGeometry x="1140" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v19" value="&lt;b&gt;5 · hire&lt;/b&gt;&lt;br&gt;&lt;br&gt;A Teams · B admin center · C Entra API script. Creates the agent identity + agent user + Frontier seat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="hiring-1">
          <mxGeometry x="1140" y="130" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v20" value="&lt;b&gt;Permissions granted&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent identity:&lt;/b&gt; manager = owner + sponsor&lt;br&gt;&lt;b&gt;Agent user:&lt;/b&gt; Frontier seat, manager&lt;br&gt;Path C: copies of the delegated grants" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="hiring-1">
          <mxGeometry x="1140" y="280" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hiring-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="hiring-1" source="hiring-v15" target="hiring-v19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v22" value="&lt;b&gt;Owner / UAA + developer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontSize=11;" vertex="1" parent="hiring-1">
          <mxGeometry x="1350" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v23" value="&lt;b&gt;6 · data access&lt;/b&gt;&lt;br&gt;&lt;br&gt;grant-bid-team-access.ps1 per instance; map instance IDs in BID_TEAM_RULES → new version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="hiring-1">
          <mxGeometry x="1350" y="130" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v24" value="&lt;b&gt;Permissions granted&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent identity:&lt;/b&gt; Search Index Data Reader on &lt;b&gt;its own index only&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="hiring-1">
          <mxGeometry x="1350" y="280" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hiring-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="hiring-1" source="hiring-v19" target="hiring-v23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v26" value="&lt;b&gt;Manager (or admin)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=11;" vertex="1" parent="hiring-1">
          <mxGeometry x="1560" y="80" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v27" value="&lt;b&gt;7 · verify + onboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;/whoami probe (200 own · 403 other), group chat, email intake, Word draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="hiring-1">
          <mxGeometry x="1560" y="130" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v28" value="&lt;b&gt;Permissions granted&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent user:&lt;/b&gt; chat memberships, shared documents" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="hiring-1">
          <mxGeometry x="1560" y="280" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hiring-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="hiring-1" source="hiring-v23" target="hiring-v27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v30" value="Where each permission lands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;arcSize=3;" vertex="1" parent="hiring-1">
          <mxGeometry x="40" y="480" width="1720" height="270" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v31" value="&lt;b&gt;Blueprint principal&lt;/b&gt; (once, for all instances)&lt;br&gt;&lt;br&gt;admin consent: Agent Tools McpServers.Word / Mail / OneDriveSharepoint / Teams.All · Messaging Bot API AgentData.ReadWrite · app role Agent365.Observability.OtelWrite&lt;br&gt;&lt;br&gt;&lt;i&gt;Put here: what every instance needs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="hiring-1">
          <mxGeometry x="60" y="520" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v32" value="&lt;b&gt;Each agent identity&lt;/b&gt; (per instance)&lt;br&gt;&lt;br&gt;Azure RBAC on its own data: Search Index Data Reader on one index&lt;br&gt;owner + sponsor = manager&lt;br&gt;(API hires: copies of the delegated grants)&lt;br&gt;&lt;br&gt;&lt;i&gt;Put here: data that differs per team&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="hiring-1">
          <mxGeometry x="480" y="520" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v33" value="&lt;b&gt;Each agent user&lt;/b&gt; (per instance)&lt;br&gt;&lt;br&gt;Frontier seat · mailbox · Teams · manager&lt;br&gt;chat memberships · shared documents&lt;br&gt;code-level routing: BID_TEAM_RULES / SEGMENT_SCOPE_RULES&lt;br&gt;&lt;br&gt;&lt;i&gt;Put here: Microsoft 365 collaboration access&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="hiring-1">
          <mxGeometry x="900" y="520" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="hiring-v34" value="&lt;b&gt;Shared container + project&lt;/b&gt;&lt;br&gt;&lt;br&gt;default instance identity: Foundry User&lt;br&gt;project managed identity: AcrPull, Cognitive Services User, monitoring&lt;br&gt;deployer: Owner (PIM), Foundry User, Log Analytics Reader, Search contributor roles&lt;br&gt;&lt;br&gt;&lt;i&gt;Never business data here&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="hiring-1">
          <mxGeometry x="1320" y="520" width="420" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="analogy" name="Analogy">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="analogy-0" />
        <mxCell id="analogy-1" parent="analogy-0" />
        <mxCell id="analogy-v1" value="Analogy – the badge office, the badge and the employee record" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="analogy-1">
          <mxGeometry x="40" y="20" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="analogy-v2" value="The blueprint holds the key; each agent identity holds the permissions and is what the audit log records; each agent user is the employee record (mailbox, Teams, manager)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="analogy-1">
          <mxGeometry x="40" y="58" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="analogy-v3" value="&lt;b&gt;🔌 Switch off the printer&lt;/b&gt;&lt;br&gt;= disable / delete the blueprint&lt;br&gt;every badge stops working" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="analogy-1">
          <mxGeometry x="120" y="110" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="analogy-v4" value="&lt;b&gt;🏢 Badge office for the role &quot;bid desk analyst&quot;&lt;/b&gt;&lt;br&gt;= &lt;b&gt;agent identity blueprint&lt;/b&gt;&lt;br&gt;keeps the printer and the signing key&lt;br&gt;(federated credential, no secrets) · can only print or revoke badges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="analogy-1">
          <mxGeometry x="480" y="105" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="analogy-v5" value="&lt;b&gt;📜 Facility rules for everyone in the role&lt;/b&gt;&lt;br&gt;canteen · intranet&lt;br&gt;= &lt;b&gt;admin consent on the blueprint&lt;/b&gt;&lt;br&gt;(inherited by every badge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="analogy-1">
          <mxGeometry x="1020" y="105" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="analogy-v6" value="&lt;b&gt;👤 Employee record&lt;/b&gt;&lt;br&gt;= &lt;b&gt;agent user&lt;/b&gt; bankingbids@…&lt;br&gt;desk · mailbox · Teams · manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="analogy-1">
          <mxGeometry x="40" y="300" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="analogy-v7" value="&lt;b&gt;🪪 Badge: BankingBids&lt;/b&gt;&lt;br&gt;= &lt;b&gt;agent identity&lt;/b&gt; 35b5cd0a-…&lt;br&gt;permissions live on the badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="analogy-1">
          <mxGeometry x="420" y="300" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="analogy-v8" value="&lt;b&gt;🪪 Badge: PublicSectorBids&lt;/b&gt;&lt;br&gt;= &lt;b&gt;agent identity&lt;/b&gt; 94b2c6ce-…&lt;br&gt;permissions live on the badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="analogy-1">
