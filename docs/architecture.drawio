        <mxCell id="lifecycle-v15" value="&lt;b&gt;Fleet (tenant administrator, standing):&lt;/b&gt; registry of every hire · audit · block blueprint (all instances stop) · retire (no new hires) · delete (cascades)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
