        <mxCell id="identity-v15" value="&lt;b&gt;Gate 1 – Consent&lt;/b&gt; governs the &lt;i&gt;token&lt;/i&gt;: which kinds of calls are ever allowed.&lt;br&gt;Set by the tenant admin at approval. Enforced by Entra ID." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="identity-v16" value="&lt;b&gt;Gate 2 – Access&lt;/b&gt; governs the &lt;i&gt;account&lt;/i&gt;: which data those calls reach.&lt;br&gt;Set per instance by the manager (or access manager). Enforced by each resource." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="identity-v17" value="&lt;b&gt;Kill switches&lt;/b&gt;&lt;br&gt;• Block instance – manager / business lead (only a tenant admin unblocks)&lt;br&gt;• Block blueprint – every instance stops at once&lt;br&gt;• Offboard instance – irreversible; agent user removed&lt;br&gt;• Retire blueprint – no new hires · Delete – cascades to all instances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="430" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="identity-v18" value="Assistive agent = agent identity acting &lt;i&gt;on behalf of&lt;/i&gt; a signed-in user · Background service = agent identity, app-only, no Microsoft 365 actions · &lt;b&gt;Autopilot = agent identity + agent user account&lt;/b&gt;, acts as itself" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="160" y="600" width="1240" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lifecycle" name="Lifecycle">
